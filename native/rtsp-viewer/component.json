{
  "id": "rtsp-viewer",
  "kind": "tool",
  "version": "0.1.9",
  "title": "RTSP Camera Receiver",
  "description": "Native RTSP/RTP H.264 receiver using the MGU Intel Media SDK; no FFmpeg dependency.",
  "license": "GPL-3.0-or-later",
  "build": "make target",
  "requires": {"mgu-render": "0.6.11"},
  "mguNeeds": ["renderer"],
  "uninstallable": true,
  "mguHmi": ["ID8"],
  "files": [
    {"path": "rtsp-viewer", "from": "build/target/rtsp-viewer", "mode": "0755"},
    {"path": "LICENSE", "from": "../../LICENSE", "mode": "0644"},
    {"path": "THIRD_PARTY_LICENSES", "from": "../../THIRD_PARTY_LICENSES", "mode": "0644"}
  ],
  "units": [
    {"name": "rtsp-viewer.service", "from": "systemd/rtsp-viewer.service"}
  ],
  "enable": [
    {"unit": "rtsp-viewer.service", "target": "multi-user.target"}
  ],
  "restart": ["rtsp-viewer.service"]
}
